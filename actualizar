#   VARIABLES GENERALES DE GESTIÓN
#El tiempo de espera para reintentar conexión de red (en segundos)
timeout=20
#Tiempos de espera (dinamismo) en segundos
esperas=0.5
#Valor $esperas*este de muestra por goteo de info final
multiplicadorEsperaFinal=0.6
#La web a la que se conecta para comprobar la conexión
# ipRed="http://1.0.0.1"
ipRed="http://one.one.one.one" #En algunas redes no va
ipRed2="youtube.com"
#Evitamos que pueda estar activado el timeout de la contraseña del sudo
sudo -k
#Colores para la fecha
  #colorNormal="\e[0m"  #No se necesita
    colorBase="\e[1;34;47m"
   colorFallo="\e[1;37;41m"
colorCorrecto="\e[1;37;42m"
colorInstalar="\e[1;31;47m"
 colorLimpiar=$colorBase

#Benvinguda
nom=$(who | awk '{printf $1}')
echo
fecha $colorBase
echo "   >>> Benvingut a l'actualitzador d'Alex, $nom :) <<<"
#sleep $esperas
fecha $colorBase
echo "       Versió.$ver"
#sleep $esperas
echo


#Obtenemos la contraseña
i=1
while [ $i -ne 0 ]
do
    #Pedimos contraseña
    fecha $colorBase
    echo -n ">Introduix la contasenya de l'administrador($i): "
    read -r -s contra
    echo

    #Comprobamos que la contraseña sea correcta (3.11.25)
    echo $contra | sudo -k -S cat /etc/passwd &>/dev/null
    if [ $? -ne 0 ]
    then
        #Si contraseña erronea
        fecha $colorFallo
        echo ">Intenta-ho de nou($i)...<"
        ((i++))
    else
        #Si contraseña correcta
        i=0
        fecha $colorCorrecto
        echo -e "\t>Contrasenya CORRECTA<"
    fi
done


#Esperamos a que haya conexión (3.11.25)
fecha $colorBase
echo ">Esperant conexió... ($ipRed)<"
i=9987
while [ $i -ne 0 ]
do
    #El retorno de wget es un 0 (a $?) cuando hay conexión
    wget -q --spider "$ipRed" || wget -q --spider "$ipRed2" # aveces una falla por la red desde la que me conecto (eduroam)

    if [ $? -ne 0 ]; #si NO equal ==> si no hay conexion
    then
        fecha $colorFallo
        echo -e ">No hi ha conexió, autocomprobació en $timeout segons. ($i)<"
        ((i++))
        if [ $i -gt 10000 ] #Evitamos que se vaya de madre la variable
        then
            i=1
        fi
        fecha $colorBase
        echo -e -n "> (apreta intro per a reintentar...)"
        read -t $timeout
        echo
    else
        #Si Tiene conexión sale del bucle
        i=0
        fecha $colorCorrecto
        echo -e "\t>Conetat a la xarxa!<"
        sleep $esperas
    fi
done


#Generamos marca de tiempo inicial
tiempoIni=$(date +%s)


#Actualizamos Caché
echo -e "\n### "
echo -n "#   Actualitzant caché "
fecha $colorBase
echo
echo "###"
echo $contra | sudo -k -S apt-get update -y #> /dev/null


#Actualizamos Firefox
echo -e "\n###"
echo -n "#   Actualitzant firefox-esr "
fecha $colorInstalar
echo
echo "###"
#Consultamos si está instalado, si lo está lo actualizamos
if dpkg -s firefox-esr >/dev/null 2>&1; then
    echo $contra | sudo -k -S apt-get upgrade --only-upgrade -y firefox-esr
    # echo $contra | sudo -k -S apt-get install -y firefox-esr #> /dev/null
else
    echo "Firefox no instalat...Ometent..."
fi
#Continuamos con sus argumentos
if [ $# -ge 1 ]; then #Mayor o igual
    #Si hay argumentos Comprobamos si queremos ejecutar firefox o actualiar argumentos
    if [ $1 = "llamada_desde_fire" ]; then #igual
        #Si el argumento es "llamada_desde_fire" querremos ejecutar firefox
        # Porque se habrá llamado desde el script fire
        fire llamada_desde_actualizar
    else
        #Actualizamos los elementos pasados como argumento
        echo $contra | sudo -k -S apt-get upgrade --only-upgrade -y $*
    fi
fi
#If you do not want to install new packages; when used in conjunction with install, only-upgrade will install upgrades for already installed packages only and ignore requests to install new packages: añadir "--only-upgrade"

#Mostramos programas a actualizar
echo -e "\n###"
echo -n "#   Mostrant programes y elements a actualitzar "
fecha $colorBase
echo
echo "###"
###
# Esta opción a veces necesita acción del usuario para
# continuar, por tanto la descarto
###
#echo $contra | sudo -S apt list --upgradable #> /dev/null
###
# Estas opciones (todas son iguales) muestran una simulación
# de upgrade, por tanto muestra los paquetes que se instalarán
# sin acción del usuario.
###
# echo $contra | sudo -k -S apt-get upgrade -s
# echo $contra | sudo -k -S apt-get upgrade --simulate
echo $contra | sudo -k -S apt-get upgrade --just-print
# echo $contra | sudo -k -S apt-get upgrade --dry-run
# echo $contra | sudo -k -S apt-get upgrade --recon
# echo $contra | sudo -k -S apt-get upgrade --no-act


#Actualizamos Programas
echo -e "\n###"
echo -n "#   Actualitzant programes y sistema "
fecha $colorInstalar
echo
echo "###"
echo $contra | sudo -k -S apt-get upgrade --with-new-pkgs -y #> /dev/null


#Eliminamos dependencias no usadas
echo -e "\n###"
echo -n "#   Aplicant autoremove "
fecha  $colorInstalar
echo
echo "###"
echo $contra | sudo -k -S apt-get autoremove -y #> /dev/null


#Borramos papelera
echo -e "\n###"
echo -n "#   Borrant paperera "
fecha $colorLimpiar
echo
echo "###"
basuraCant=$(tree ~/.local/share/Trash | wc -l)
if (( basuraCant == 3 ));
then
    basuraCant=0
else
    basuraCant=$((basuraCant-5))
    basuraCant=$((basuraCant/2))
fi
fecha $colorLimpiar
echo -e ">Hi ha $basuraCant elements a eliminar.<"
fecha $colorLimpiar
echo -n ">Espai a recuperar: "
du -hs ~/.local/share/Trash | awk '{printf $1}'
echo " <"
fecha $colorLimpiar
echo -e "\t>Borrant elements...<"
rm -rf ~/.local/share/Trash/*
fecha $colorLimpiar
echo ">Paperera esborrada.<"


#Resumen del final
echo -e "\n###"
echo -n "#   Resumen Final "
fecha $colorBase
echo
echo "###"
#Esperas del doble que en el resto del programa
sleep $(echo "$esperas * $multiplicadorEsperaFinal" | bc)
#Eliminamos el timeout de validez de la contraseña de sudo y salimos
sudo -k
#Obtenemos marca de tiempo final y la duración total
tiempoFin=$(date +%s)
fecha $colorCorrecto
echo ">L'actualizació ha tardat $(($tiempoFin-$tiempoIni)) segons.<"
sleep $(echo "$esperas * $multiplicadorEsperaFinal" | bc)
fecha $colorCorrecto
echo ">S'han eliminat $basuraCant elements de la paperera.<"
sleep $(echo "$esperas * $multiplicadorEsperaFinal" | bc)
fecha $colorCorrecto
echo -e ">La finestra es tancará en 1 minut. (Ctrl+C per evitar-ho).<"
sleep $(echo "$esperas * $multiplicadorEsperaFinal" | bc)
fecha $colorCorrecto
echo -e "\t>Finalitzat...<\n"
